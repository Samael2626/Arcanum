<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HTTP en claro tambien en profile, igual que en debug: profile es el
         build para medir fluidez en el movil fisico contra el backend local
         (adb reverse tcp:8000). Sin esto Android bloquea http://127.0.0.1 y la
         app da error de conexion sin que llegue ni una peticion al backend.

         Source set `profile`, no `main`: release sigue sin cleartext. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
