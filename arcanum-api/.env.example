# Copia este fichero a .env y rellena los valores.
# .env está en .gitignore y NUNCA debe commitearse.
#
# NUNCA pegues secretos reales en un chat, ticket o captura: quedan escritos
# en disco y hay que rotarlos. Cópialos solo del panel del proveedor a .env.

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=True
ENVIRONMENT=development
APP_NAME="Arcanum API"
APP_VERSION="0.1.0"

# ── Base de datos ────────────────────────────────────────────────────────
# Local:      postgresql://postgres:postgrespassword@localhost:5432/arcanum_db
# Producción: Supabase con el TRANSACTION POOLER (puerto 6543), no la conexión
#   directa (5432). La directa es IPv6-only y rompe en hosts IPv4 — fue lo que
#   tumbó Render 15 h. El host del pooler tiene la forma:
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-1-REGION.pooler.supabase.com:6543/postgres

# ── Seguridad ────────────────────────────────────────────────────────────
# Genera un valor aleatorio de al menos 32 bytes para producción, p.ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=development-only-change-me
ADMIN_TOKEN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Oráculo IA (Groq) ────────────────────────────────────────────────────
# console.groq.com/keys. Free tier. La MISMA cuenta la usan el oráculo en
# producción y el traductor de Lecturas: no la agotes ni crees cuentas extra.
GROQ_API_KEY=

# ── Redis (rate limiting; opcional en local) ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────
# Orígenes del frontend. El puerto importa: la PWA local debe servirse en
# 8080 o 3000 para que CORS la acepte.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://arcanum-app-magick.web.app
