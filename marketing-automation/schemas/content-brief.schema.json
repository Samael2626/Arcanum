{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/schemas/content-brief.schema.json",
  "title": "ArcanumContentBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "external_key",
    "pillar",
    "objective",
    "audience",
    "angle",
    "primary_format",
    "derived_formats",
    "premise",
    "facts",
    "sources",
    "warnings",
    "asset"
  ],
  "properties": {
    "external_key": { "type": "string", "minLength": 8, "maxLength": 120 },
    "pillar": {
      "type": "string",
      "enum": ["cielo", "astrologia", "tarot", "materia", "practica", "producto", "manifiesto"]
    },
    "objective": {
      "type": "string",
      "enum": ["awareness", "education", "consideration", "conversion"]
    },
    "audience": { "type": "string", "minLength": 10, "maxLength": 240 },
    "angle": {
      "type": "string",
      "enum": ["friction", "practice", "function", "technical_proof"]
    },
    "primary_format": {
      "type": "string",
      "enum": ["static", "carousel", "story", "short_video"]
    },
    "derived_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["static", "carousel", "story", "short_video"]
      }
    },
    "premise": { "type": "string", "minLength": 10, "maxLength": 400 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "source_id"],
        "properties": {
          "claim": { "type": "string", "minLength": 5 },
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reference"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["repo", "catalog", "ephemeris", "manual"] },
          "reference": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "asset": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "license"],
      "properties": {
        "path": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": ["string", "null"] }
      }
    }
  }
}
