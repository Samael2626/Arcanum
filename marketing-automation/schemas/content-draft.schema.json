{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanum.local/schemas/content-draft.schema.json",
  "title": "ArcanumContentDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["hook", "script", "carousel", "caption", "cta", "alt_text", "source_ids", "compliance"],
  "properties": {
    "hook": { "type": "string", "minLength": 20, "maxLength": 120 },
    "script": { "type": "string", "minLength": 100, "maxLength": 700 },
    "carousel": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "caption": { "type": "string", "minLength": 1, "maxLength": 900 },
    "cta": { "type": "string", "minLength": 3, "maxLength": 120 },
    "alt_text": { "type": "string", "maxLength": 500 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_supported", "warnings_applied"],
      "properties": {
        "claims_supported": { "const": true },
        "warnings_applied": { "const": true }
      }
    }
  }
}
